# Required. Coolify: runtime variables only; mark tokens as secrets.
DISCORD_TOKEN=
GUILD_ID=
# Optional at startup (derived from the logged-in bot); required for npm run commands.
CLIENT_ID=

# Optional integrations. Missing credentials disable the relevant service gracefully.
WORKER_URL=
# Hall v2: worker origin, e.g. https://hall.davevancauwenberghe.be
# Match the Worker's DISCORD_API_KEY secret. Required for /ask and /forget.
# This is a shared bot-to-Worker secret, not OPENAI_API_KEY or DISCORD_TOKEN.
# Coolify: enable at runtime in production, save, then redeploy the bot.
HALLAI_API_KEY=
ROBLOX_GROUP_ID=36060455
EASYPOS_TOKEN=

SUPPORT_CHANNEL_ID=
GENERAL_CHANNEL_ID=
COMMANDS_CHANNEL_ID=
GIVEAWAY_MIN_ROLE_ID=
CITYCRAFT_OWNER_USER_ID=651525636351066182
CITYCRAFT_ADDRESS=citycraft.davevancauwenberghe.be
CITYCRAFT_STATUS_HOST=157.173.101.60
CITYCRAFT_STATUS_PORT=25565

# Mount the Coolify persistent volume at /data; do not publish port 8080.
DATA_DIR=/data
PORT=8080
TIME_ZONE=Europe/Brussels

