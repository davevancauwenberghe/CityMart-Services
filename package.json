{
  "name": "citymart-bot",
  "version": "1.4.1",
  "private": true,
  "description": "CityMart Services: slash commands, community services and giveaways",
  "type": "module",
  "engines": {
    "node": "^24.15.0 || ^26.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "commands": "node --env-file-if-exists=.env dist/register.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "format": "prettier --write src tests *.json *.md .github",
    "format:check": "prettier --check src tests *.json *.md .github"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "luxon": "3.7.2"
  },
  "devDependencies": {
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
